# ============================================================
# AgentTalk 运行时配置模板（初始状态）
# ============================================================
# 用法：
#   cp config/bot.env.example /root/deploy/bot.env
#   chmod 600 /root/deploy/bot.env
#   chown root:root /root/deploy/bot.env
#   然后填入真实密钥
#
# ⚠️ 格式铁律（否则热配置解析不到）：
#   1. 每行必须是  export KEY="value"
#   2. 值必须用【双引号】包裹
#   3. 【禁止行内注释】：`export K="v"  # 说明` 会导致该行不被热解析
#      注释必须单独成行
# ============================================================

# ------------------------------------------------------------
# 一、模型
# ------------------------------------------------------------
export DEEPSEEK_API_KEY=""
export DEEPSEEK_BASE_URL="https://api.deepseek.com"
export DEEPSEEK_MODEL="deepseek-chat"
# 兼容旧变量名（部分插件读 OPENAI_API_KEY，与上面保持一致即可）
export OPENAI_API_KEY=""

# 计价（元 / 百万 token），用于 #状态 用量折算
export BOT_PRICE_INPUT_PER_M="1"
export BOT_PRICE_OUTPUT_PER_M="2"

# ------------------------------------------------------------
# 二、网关（NapCat / SnowLuma 共用端口契约）
# ------------------------------------------------------------
# ws 端点：两代网关都监听 127.0.0.1:3001，切换时不用改
export NAPCAT_WS_ENDPOINT="ws://127.0.0.1:3001"
# OneBot WS access token（NapCat 与 SnowLuma 必须设成同一个值）
export NAPCAT_WS_TOKEN=""
# 机器人 QQ 号
export NAPCAT_SELF_ID=""
# 快速登录号（napcat launcher 会转成 -q）。不设则回退二维码，
# headless 无人值守时会永久卡在扫码页。首次登录仍需人工扫一次码。
export NAPCAT_QUICK_LOGIN=""

# 当前网关实现：napcat | snowluma（守护脚本据此拉起不同进程）
export BOT_GATEWAY="napcat"

# ------------------------------------------------------------
# 三、Koishi
# ------------------------------------------------------------
export KOISHI_PORT="5140"

# ------------------------------------------------------------
# 四、名单与策略（留空 = 不设限，全部放行）
# ------------------------------------------------------------
# 白名单：空 = 放行所有；有值 = 仅名单内（逗号分隔）
export BOT_ALLOWED_USERS=""
export BOT_ALLOWED_GROUPS=""

# 黑名单：优先级高于白名单，管理员也无法豁免
export BOT_BLACKLIST_USERS=""
export BOT_BLACKLIST_GROUPS=""

# QQ 内管理员（可执行 #状态 / #重置对话）
export BOT_ADMIN_USERS=""
# 管理员指令是否在群聊生效：空/0 = 仅私聊；1 = 群里 @机器人 也可用
export BOT_ADMIN_GROUP=""

# @ 硬锁（保留变量，当前逻辑已由 BOT_ACTIVE_WINDOW_MS 接管）
export BOT_AT_ONLY="1"

# ------------------------------------------------------------
# 五、人格 / 上下文
# ------------------------------------------------------------
# 人格切换（见 lib/persona.js 的注册表）：yuanfang=鲸元芳（默认）；shirley=橘雪莉（魔女审判·仍自称元芳）。
# 留空 = 用代码里的 DEFAULT_PERSONA_ID；非法值自动回落默认。新增人格只需在 persona.js 加一条然后写它的 id。
export BOT_PERSONA="yuanfang"
# 留空 = 使用插件内置默认人格（lib/persona.js 的「鲸元芳」，已带口语化/反 AI 腔规则）。
# ⚠ 内置人格是多行带换行的长 prompt，只能放代码；这里要自定义必须写成单行，且会覆盖上面的人格 prompt。
export BOT_SYSTEM_PROMPT=""
# few-shot 示例注入（把几组范例对话喂给模型以锚定语气）：空/1 = 开；0 = 关。
# 关掉后只靠上面的 system prompt 塑形，省一点 token。示例内容见 lib/persona.js 的 FEWSHOT。
export BOT_FEWSHOT_ENABLED="1"
# 多轮上下文轮数在 koishi.config.js 的 maxTurns 调整

# @ 前群聊上下文：最近 N 条 / T 毫秒（0 = 关闭）
export BOT_GROUP_CONTEXT_MAX="6"
export BOT_GROUP_CONTEXT_MS="120000"

# @ 后免 @ 活跃窗口（毫秒）；0 = 恢复"每次必须 @"
export BOT_ACTIVE_WINDOW_MS="120000"

# ------------------------------------------------------------
# 六、内容安全
# ------------------------------------------------------------
# 敏感词，逗号分隔（输入命中回固定话术，输出命中拦截不发送）
export BOT_SENSITIVE_WORDS=""
# 命中时是否在当前会话提示：1 = 提示；空 = 仅记日志
export BOT_SENSITIVE_NOTIFY=""

# ------------------------------------------------------------
# 六·补、大型任务校验（按“构建意图”拦截，省 token）
# ------------------------------------------------------------
# 面对“帮我编写1个lol程序 / 做个…游戏 / 开发…网站”这类让机器人从零造大东西的需求，
# 直接玩笑回绝、不进模型，避免把 token 烧穿。
# 不看字数！只看“构建意图”：同时命中【动作+对象】（如“编写…程序”），或命中整段大工程短语。
# 纯启发式、不做语义理解；误伤时用户换个说法即可。
# 开关：空/1 = 开；0 = 关（关掉后一切请求照常进模型）
export BOT_BIGTASK_GUARD="1"
# 动作词，逗号分隔（留空 = 用内置默认）。需与下面“对象词”同时命中才算构建意图
export BOT_BIGTASK_ACTIONS=""
# 对象词，逗号分隔（留空 = 用内置默认：程序/游戏/软件/系统/网站/app/小程序…）
export BOT_BIGTASK_OBJECTS=""
# 大工程短语，逗号分隔（留空 = 用内置默认）；单独命中一个即可回绝
export BOT_BIGTASK_KEYWORDS=""
# 命中时回复的话术（留空 = 默认“你在开玩笑吗，做不到哈哈”）
export BOT_BIGTASK_REPLY=""

# ------------------------------------------------------------
# 七、媒体
# ------------------------------------------------------------
# 图片识别开关（需多模态端点，纯文本模型下无效）
export BOT_IMAGE_ENABLED="0"
export BOT_IMAGE_MAX="2"
export BOT_IMAGE_TIMEOUT_MS="20000"

# ------------------------------------------------------------
# 八、联网能力（搜索 / 天气）
# ------------------------------------------------------------
# 搜索：Bing 免 key + function calling，由模型自己判断要不要搜。
# 未选 DuckDuckGo：它在阿里云这台机上三个端均 12s 超时（完全不可达）。
# ⚠ 长查询（带日期、带“今天”“未来三天”）会让 cn.bing 退化成百科/旅游页，
#   所以 lib/websearch.js 里做了查询词归一化 + 结果质量闸 + 自动重试。
export BOT_SEARCH_ENABLED="1"
export BOT_SEARCH_MAX_ROUNDS="2"
export BOT_SEARCH_MAX_RESULTS="5"
export BOT_SEARCH_TIMEOUT_MS="8000"
# 天气：必须走独立数据源，不能让模型用 web_search 搜天气——搜索只拿标题+摘要，
# 拿不到温度数值（11-02 实际踩过：回答“没搜到实时天气”）。
# 主源 Open-Meteo（免 key，区县级坐标），失败自动降级 wttr.in（观测站口径）。
# 问天气时没说城市，按 DEFAULT_CITY 回答；留空则让模型反问哪个城市。
export BOT_WEATHER_ENABLED="1"
export BOT_WEATHER_DEFAULT_CITY="苏州"
export BOT_WEATHER_TIMEOUT_MS="6000"

# ------------------------------------------------------------
# 八·补、定时提醒（“X分钟后/几点 提醒我……”，到点主动发消息）
# ------------------------------------------------------------
# 提醒走模型工具 set_reminder/list_reminders/cancel_reminder，不依赖联网（搜索关了也能用）。
# 到点投递走 sender.notify（不带引用段，避免残留 quoteId 被判 1400）。
# 提醒表落盘在 BOT_STATE_DIR/reminders.json，重启后自动恢复未触发的（逾期超 10min 不补发）。
# 开关：空/1 = 开；0 = 关（关掉后模型会被告知“叫不了”，不再口头假装）。
export BOT_REMINDER_ENABLED="1"
# 单个会话最多待触发提醒数（防滥用）
export BOT_REMINDER_MAX_PER_CHAT="10"
# 全进程待触发提醒总量上限
export BOT_REMINDER_MAX_TOTAL="200"
# 最长可预约时长（秒，默认 24h）；更远的提醒会引导用户自己设闹钟
export BOT_REMINDER_MAX_DELAY_S="86400"
# 群聊到点是否默认 @ 设提醒人（严格@模式下不带@机器人接不住后续）：1=开；空/0=不@
export BOT_REMINDER_AT_REQUESTER="1"
# 到点一条提醒最多 @ 几个人（防刷群）；0=完全不@
export BOT_REMINDER_MAX_AT="5"
# 到点是否「重跑模型+工具真的执行任务」（查天气/搜索/@人）再把结果发回会话：1=开；0=只发固定提醒文案（省 token）
export BOT_REMINDER_EXEC="1"

# ------------------------------------------------------------
# 九、状态与热配置
# ------------------------------------------------------------
# 历史/用量落盘目录
export BOT_STATE_DIR="/opt/koishi/state/deepseek"
# 热配置监听的文件（改这个文件 5s 内自动生效，无需重启）
export BOT_ENV_FILE="/root/deploy/bot.env"
# 热配置巡检间隔（毫秒，下限 2000）
export BOT_HOT_INTERVAL_MS="5000"

# 机器人回复是否引用原消息（群聊首条）：1 = 开；空 = 关
export BOT_QUOTE_REPLY=""
