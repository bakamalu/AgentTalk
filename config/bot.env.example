# ============================================================
# AgentTalk 运行时配置模板（初始状态）
# ============================================================
# 用法：
#   cp config/bot.env.example /root/deploy/bot.env
#   chmod 600 /root/deploy/bot.env
#   chown root:root /root/deploy/bot.env
#   然后填入真实密钥
#
# ⚠️ 格式铁律（否则热配置解析不到）：
#   1. 每行必须是  export KEY="value"
#   2. 值必须用【双引号】包裹
#   3. 【禁止行内注释】：`export K="v"  # 说明` 会导致该行不被热解析
#      注释必须单独成行
# ============================================================

# ------------------------------------------------------------
# 一、模型
# ------------------------------------------------------------
export DEEPSEEK_API_KEY=""
export DEEPSEEK_BASE_URL="https://api.deepseek.com"
export DEEPSEEK_MODEL="deepseek-chat"
# 兼容旧变量名（部分插件读 OPENAI_API_KEY，与上面保持一致即可）
export OPENAI_API_KEY=""

# 计价（元 / 百万 token），用于 #状态 用量折算
export BOT_PRICE_INPUT_PER_M="1"
export BOT_PRICE_OUTPUT_PER_M="2"

# ------------------------------------------------------------
# 二、网关（NapCat / SnowLuma 共用端口契约）
# ------------------------------------------------------------
# ws 端点：两代网关都监听 127.0.0.1:3001，切换时不用改
export NAPCAT_WS_ENDPOINT="ws://127.0.0.1:3001"
# OneBot WS access token（NapCat 与 SnowLuma 必须设成同一个值）
export NAPCAT_WS_TOKEN=""
# 机器人 QQ 号
export NAPCAT_SELF_ID=""

# 当前网关实现：napcat | snowluma（守护脚本据此拉起不同进程）
export BOT_GATEWAY="napcat"

# ------------------------------------------------------------
# 三、Koishi
# ------------------------------------------------------------
export KOISHI_PORT="5140"

# ------------------------------------------------------------
# 四、名单与策略（留空 = 不设限，全部放行）
# ------------------------------------------------------------
# 白名单：空 = 放行所有；有值 = 仅名单内（逗号分隔）
export BOT_ALLOWED_USERS=""
export BOT_ALLOWED_GROUPS=""

# 黑名单：优先级高于白名单，管理员也无法豁免
export BOT_BLACKLIST_USERS=""
export BOT_BLACKLIST_GROUPS=""

# QQ 内管理员（可执行 #状态 / #重置对话）
export BOT_ADMIN_USERS=""
# 管理员指令是否在群聊生效：空/0 = 仅私聊；1 = 群里 @机器人 也可用
export BOT_ADMIN_GROUP=""

# @ 硬锁（保留变量，当前逻辑已由 BOT_ACTIVE_WINDOW_MS 接管）
export BOT_AT_ONLY="1"

# ------------------------------------------------------------
# 五、人格 / 上下文
# ------------------------------------------------------------
# 留空 = 使用插件内置默认人格
export BOT_SYSTEM_PROMPT=""
# 多轮上下文轮数在 koishi.config.js 的 maxTurns 调整

# @ 前群聊上下文：最近 N 条 / T 毫秒（0 = 关闭）
export BOT_GROUP_CONTEXT_MAX="6"
export BOT_GROUP_CONTEXT_MS="120000"

# @ 后免 @ 活跃窗口（毫秒）；0 = 恢复"每次必须 @"
export BOT_ACTIVE_WINDOW_MS="120000"

# ------------------------------------------------------------
# 六、内容安全
# ------------------------------------------------------------
# 敏感词，逗号分隔（输入命中回固定话术，输出命中拦截不发送）
export BOT_SENSITIVE_WORDS=""
# 命中时是否在当前会话提示：1 = 提示；空 = 仅记日志
export BOT_SENSITIVE_NOTIFY=""

# ------------------------------------------------------------
# 七、媒体
# ------------------------------------------------------------
# 图片识别开关（需多模态端点，纯文本模型下无效）
export BOT_IMAGE_ENABLED="0"
export BOT_IMAGE_MAX="2"
export BOT_IMAGE_TIMEOUT_MS="20000"

# ------------------------------------------------------------
# 八、状态与热配置
# ------------------------------------------------------------
# 历史/用量落盘目录
export BOT_STATE_DIR="/opt/koishi/state/deepseek"
# 热配置监听的文件（改这个文件 5s 内自动生效，无需重启）
export BOT_ENV_FILE="/root/deploy/bot.env"
# 热配置巡检间隔（毫秒，下限 2000）
export BOT_HOT_INTERVAL_MS="5000"

# 机器人回复是否引用原消息（群聊首条）：1 = 开；空 = 关
export BOT_QUOTE_REPLY=""
